post_install() {
  systemd-sysusers escapepod.conf
  systemd-tmpfiles --create escapepod.conf
  udevadm control --reload-rules
  udevadm trigger --subsystem-match=input --subsystem-match=misc
  echo "Escape Pod: write /etc/escapepod/config.toml (see /usr/share/doc/escapepod/config.example.toml),"
  echo "then: systemctl enable --now escapepod.service"
}

post_upgrade() {
  post_install
}
