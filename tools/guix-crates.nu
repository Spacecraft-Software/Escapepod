#!/usr/bin/env nu
# SPDX-FileCopyrightText: 2026 Mohamed Hammad <Mohamed.Hammad@SpacecraftSoftware.org>
# SPDX-License-Identifier: GPL-3.0-or-later
#
# Writes packaging/guix-crates.scm, the crates.io sources Guix's offline
# cargo-build-system vendors, straight from Cargo.lock: each locked crate's
# SHA-256 (Cargo.lock `checksum`) converted to the base32 Guix uses, with
# `nix hash convert`. This is what `guix import crate --lockfile` produces,
# without needing Guix on the machine. --check fails when the file is stale.

# The Guix crate-source definitions for every crates.io package.
def render []: nothing -> string {
    let crates = (
        open --raw Cargo.lock | from toml
        | get package
        | where { |p| ($p.source? | default "") starts-with "registry+" }
    )
    let defs = (
        $crates | each { |p|
            let nix32 = (^nix hash convert --hash-algo sha256 --to nix32 $p.checksum | str trim)
            { name: $"rust-($p.name)-($p.version)" text: $"\(define rust-($p.name)-($p.version)\n  \(crate-source \"($p.name)\" \"($p.version)\"\n                \"($nix32)\"\)\)\n" }
        }
    )
    # REUSE-IgnoreStart (these strings are the generated file's own header)
    let head = [
        ";;; SPDX-FileCopyrightText: 2026 Mohamed Hammad <Mohamed.Hammad@SpacecraftSoftware.org>"
        ";;; SPDX-License-Identifier: GPL-3.0-or-later"
        # REUSE-IgnoreEnd
        ";;;"
        ";;; GENERATED by `nu tools/guix-crates.nu` from Cargo.lock. Do not edit:"
        ";;; the crates.io sources Guix vendors for an offline cargo build."
        ""
        ""
    ] | str join "\n"
    let list = ($defs | get name | each { |n| $"        ($n)" } | str join "\n")
    $head + ($defs | get text | str join "\n") + $"\n\(define escapepod-cargo-inputs\n  \(list\n($list)\)\)\n"
}

# Writes the file, or with --check fails when it differs from Cargo.lock.
def main [
    --check # Fail when packaging/guix-crates.scm is stale
]: nothing -> nothing {
    let text = (render)
    if $check {
        if (open --raw packaging/guix-crates.scm) != $text {
            print -e "[ERROR] guix-crates: packaging/guix-crates.scm is stale"
            print -e "hint: nu tools/guix-crates.nu"
            exit 1
        }
        print -e "[OK] guix-crates: packaging/guix-crates.scm matches Cargo.lock"
    } else {
        $text | save --force packaging/guix-crates.scm
        print -e "[OK] guix-crates: wrote packaging/guix-crates.scm"
    }
}
