#!/usr/bin/env nu
# SPDX-FileCopyrightText: 2026 Mohamed Hammad <Mohamed.Hammad@SpacecraftSoftware.org>
# SPDX-License-Identifier: GPL-3.0-or-later
#
# Renders doc/requirements.texi, the `Requirements' chapter of the manual
# (the Category B SRS, Standard §19.3 and §20), from doc/requirements.toml.
# The TOML is the source of truth; the .texi is committed, and CI
# regenerates it and diffs (freshness gate), so the two cannot drift.
# Ported from Operator's tools/srs.nu.

# Milestone headings, character for character as in PRD.md.
const MILESTONES = {
    M0: "Foundation and compliance"
    M1: "Tap/hold engine"
    M2: "CLI, config and agent surface"
    M3: "evdev backend and safety"
    M4: "X11 fallback backend"
    M5: "Privileges, packaging and manual"
    M6: "Verification and release gate"
}

# Escapes the three Texinfo-active characters, then renders `code` spans
# and `10^7` superscripts.
def texi [s: string]: nothing -> string {
    $s
    | str replace -a "@" "@@"
    | str replace -a "{" "@{"
    | str replace -a "}" "@}"
    | str replace -a -r '`([^`]+)`' '@code{$1}'
    | str replace -a -r '\^([0-9]+)' '@sup{$1}'
}

# Builds the chapter text from the requirement rows.
def render [reqs: list<record>]: nothing -> string {
    let by_ms = ($reqs | group-by milestone)
    # REUSE-IgnoreStart (these strings are the generated file's header)
    mut out = [
        "@c SPDX-FileCopyrightText: 2026 Mohamed Hammad <Mohamed.Hammad@SpacecraftSoftware.org>"
        "@c SPDX-License-Identifier: CC-BY-SA-4.0"
        "@c GENERATED by tools/srs.nu from doc/requirements.toml; do not edit, regenerate."
        # REUSE-IgnoreEnd
        ""
        "@node Requirements"
        "@chapter Requirements"
        "@cindex requirements"
        "@cindex SRS"
        ""
        "Every requirement uses the §20.6 sentence pattern and carries the five"
        "§20.3 attributes.  Identifiers are permanent and never reused.  The"
        "status of each requirement is the denominator of the §17.1 progress"
        "figures (@file{tools/trace.nu})."
        ""
        "@menu"
    ]
    let present = ($MILESTONES | columns | where { |m| $m in ($by_ms | columns) })
    for ms in $present {
        let entry = ($"* ($ms)::" | fill -a left -w 8)
        $out = ($out | append $"($entry)($MILESTONES | get $ms).")
    }
    $out = ($out | append ["@end menu" ""])
    for ms in $present {
        $out = ($out | append [
            $"@node ($ms)"
            $"@section ($ms) --- ($MILESTONES | get $ms)"
            ""
            "@table @asis"
        ])
        for r in ($by_ms | get $ms | sort-by id) {
            let method = if ($r.verification? | is-empty) {
                $r.method
            } else {
                $"($r.method) \((texi $r.verification)\)"
            }
            $out = ($out | append [
                $"@item ($r.id) @emph{(texi $r.title)}"
                $"@anchor{($r.id)}"
                (texi $r.statement)
                ""
                $"Rationale: (texi $r.rationale)  Source: (texi $r.source).  Method: ($method).  Priority: ($r.priority).  Status: ($r.status)."
                ""
            ])
        }
        $out = ($out | append ["@end table" ""])
    }
    ($out | str join "\n") + "\n"
}

# Writes doc/requirements.texi, or with --check fails when it is stale.
def main [
    --check # Render to memory only; exit 1 if it differs from the committed file
]: nothing -> nothing {
    let reqs = (open doc/requirements.toml | get requirement)
    let text = (render $reqs)
    if $check {
        let current = if ("doc/requirements.texi" | path exists) {
            open --raw doc/requirements.texi
        } else { "" }
        if $current == $text {
            print -e "[OK] srs: doc/requirements.texi is fresh"
        } else {
            print -e "[ERROR] srs: doc/requirements.texi is stale"
            print -e "hint: nu tools/srs.nu"
            exit 1
        }
    } else {
        $text | save --force doc/requirements.texi
        print -e $"[OK] srs: wrote doc/requirements.texi \(($reqs | length) requirements\)"
    }
}
