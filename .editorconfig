#
# Steelbore Standard §6.5 — carries the LF / UTF-8 / final-newline rule to
# editors that never consult Git.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{nix,toml,yml,yaml,json,md}]
indent_size = 2
